# ── Museek 後端環境變數 ──────────────────────────────────────────────
# 複製成 .env 後再填：cp .env.example .env
# 金鑰只存在後端，前端一律只打自家 /api/*（合規檢核表）。
#
# 想先跑起來看看？什麼都不用填。預設值就能端到端跑通：
# 儲存用記憶體、YouTube 走 stub、LLM 走規則式、ReccoBeats 打真實公開 API。


# ═══ 儲存 ═══════════════════════════════════════════════════════════
# auto      有 MONGO_URL 就用 Mongo，連不上或沒設就退記憶體版。
#           注意：auto 不會選 Firestore——Firestore 只能明確指定
# memory    記憶體 + 落檔到 data/cache.json，本機開發最省事
# mongo     需要 MONGO_URL。本機起一個：
#           docker run -d -p 27017:27017 mirror.gcr.io/library/mongo:7
# firestore 需要 GCP_PROJECT 與 GCP 認證。Cloud Run 上會自動帶入；
#           本機要用的話得先跑 gcloud auth application-default login，
#           那會直接連到雲端的 Firestore（跟線上服務同一份資料，小心誤改）
STORAGE_BACKEND=memory
# GCP_PROJECT=

# 留空或連不上就自動退記憶體版
MONGO_URL=
MONGO_DB=museek
ALLOW_MEMORY_FALLBACK=true


# ═══ YouTube Data API ═══════════════════════════════════════════════
# 沒填就走 stub，一點配額都不會燒，但推薦結果無法真的播放。
# 注意：金鑰請在 GCP Console 設定使用限制（只勾 YouTube Data API v3）。
YOUTUBE_API_KEY=

# 多把金鑰輪替（逗號分隔）。一把的當日配額用盡就換下一把。
# ⚠️ 這是跨多個 GCP 專案取用配額。Google 條款視為規避配額，可能導致
#    清單裡每一把金鑰與其所屬專案一併被撤銷。使用前請確認每位擁有者都知情。
#    沒有風險的替代做法是預熱快取，見 NOTES.md #37。
# YOUTUBE_API_KEYS=


# ═══ ReccoBeats（音訊特徵）═════════════════════════════════════════
# 這是公開 API，不需要金鑰。
# auto  先打真的、失敗自動退 stub（建議）
# stub  完全不對外，用內建的 40 首假曲庫
# live  只打真的，失敗就失敗
RECCOBEATS_MODE=auto
# RECCOBEATS_BASE_URL=https://api.reccobeats.com

# 曲庫第一趟查不到時的補救。關掉的話那些歌完全沒有特徵，
# 品味向量會出現一整排 0.00（NOTES.md #38、#39）。分兩段：
#   RECCOBEATS_RECOVERY  別名回查——曲庫是 Spotify 血統，茄子蛋在裡面叫
#                        EggPlantEgg。用 iTunes 的中英對照再查一次曲庫，
#                        拿得到真的 recco_id（＝推薦種子），約 1 秒
#   RECCOBEATS_ANALYSIS  音訊分析——曲庫真的沒有這首歌時，抓 30 秒試聽片段
#                        丟進分析端點算特徵。拿不到 id，約 3 秒
# 關掉 RECOVERY 等於兩段都關。
RECCOBEATS_RECOVERY=true
RECCOBEATS_ANALYSIS=true
# 別名與試聽片段都來自 iTunes 公開搜尋 API，免金鑰。TW 排在前面是因為
# 華語曲名在美國商店只查得到羅馬拼音、甚至意譯版本（浪子回頭→Back Here Again）。
# ITUNES_COUNTRIES=TW,US
# 每次 session 最多補救幾首。調高會讓 /api/session 變慢。
# RECOVERY_MAX_PER_SESSION=12
# ANALYSIS_TIMEOUT=20


# ═══ LLM ════════════════════════════════════════════════════════════
# stub      規則式解析，不打任何 LLM。沒有金鑰也能完整跑完
# azure     Azure OpenAI
# gateway   任何 OpenAI 相容端點（地端 vLLM、Ollama、LM Studio 等）
# external  Anthropic API
LLM_CHANNEL=stub
LLM_TIMEOUT=60
# 只有 LLM 呼叫會走這個 proxy，YouTube 與資料庫一律直連
# LLM_PROXY=

# --- azure ---
# AZURE_ENDPOINT=https://<資源名>.openai.azure.com
# AZURE_DEPLOYMENT=            # 部署名稱，不是模型名稱
# AZURE_API_KEY=
# AZURE_API_VERSION=2024-12-01-preview
# 參數風格：auto 會先試 modern（max_completion_tokens、不帶 temperature），
# 被拒再退 legacy（max_tokens + temperature）。gpt-5.x 只吃 modern
# AZURE_PARAM_STYLE=auto
# 推理模型的預算要涵蓋「思考 + 輸出」。給太小會拿到空的 content，
# 理由會靜默退回模板句（NOTES.md #28）
# AZURE_MIN_COMPLETION_TOKENS=2000

# --- gateway（OpenAI 相容）---
# GATEWAY_BASE_URL=http://localhost:8000/v1
# GATEWAY_MODEL=
# GATEWAY_TOKEN=
# 推理模型（qwen3 等）預設會把 max_tokens 花在思考上導致 content 為空，必須關掉。
# Azure OpenAI 不吃這個參數，走 azure 通道時無效
# GATEWAY_DISABLE_THINKING=true

# --- external（Anthropic）---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=


# ═══ 配額控管（§8）═════════════════════════════════════════════════
QUOTA_DAILY_LIMIT=10000
QUOTA_CIRCUIT_BREAKER=8000      # 超過就切「僅用快取」模式
QUOTA_COST_SEARCH=100           # search.list 每次 100 點
QUOTA_COST_PLAYLIST_ITEMS=1
VERIFY_PER_ROUND=8              # 單輪最多驗證幾首（Top 5 + 3 備位）
RETURN_PER_ROUND=5


# ═══ Discovery Ranker 參數（調校用，改這裡不用動程式）═══════════════
BAND_CENTER=0.72
BAND_WIDTH=0.12
WEIGHT_BAND=0.45
WEIGHT_CONTEXT=0.30
WEIGHT_NOVELTY=0.25
ECHO_CHAMBER_PENALTY=0.55
HARD_FILTER=true


# ═══ 其他 ═══════════════════════════════════════════════════════════
HTTP_TIMEOUT=4                  # ReccoBeats 逾時秒數，重試 1 次
LOG_DIR=logs
