# ── Museek 後端環境變數 ──────────────────────────────────────────────
# 複製成 .env 後再填。金鑰只存在後端，前端一律只打自家 /api/*（合規檢核表）。

# YouTube Data API：沒填就走 stub，一點配額都不會燒。
# 開發期紀律（§8）：只有 D2 該填這一格。
YOUTUBE_API_KEY=

# ReccoBeats：auto = 先打真的、失敗自動退 stub；stub = 完全不對外；live = 只打真的
RECCOBEATS_MODE=stub

# LLM 通道（§1.2）：stub = 規則式不打 LLM；external = Anthropic API；gateway = OpenAI 相容端點
LLM_CHANNEL=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# gateway 通道：地端 vLLM 或 Azure OpenAI 都走這裡
# GATEWAY_BASE_URL=http://llm-host:8000/v1
# GATEWAY_MODEL=qwen3.8-27b
# GATEWAY_TOKEN=
# LLM_TIMEOUT=60
# 推理型模型（qwen3 等）預設會把 max_tokens 花在思考上導致 content 為空，必須關掉。
# 換 Azure OpenAI 時要設 false——它不吃 chat_template_kwargs。詳見 NOTES.md #3、#4
# GATEWAY_DISABLE_THINKING=true

# MongoDB：留空或連不上就自動用記憶體儲存（快取不跨重啟保留）
MONGO_URL=mongodb://localhost:27017
MONGO_DB=museek

# Discovery Ranker 參數（Day 5 調校用，改這裡不用動程式）
BAND_CENTER=0.72
BAND_WIDTH=0.12
WEIGHT_BAND=0.45
WEIGHT_CONTEXT=0.30
WEIGHT_NOVELTY=0.25
ECHO_CHAMBER_PENALTY=0.55
HARD_FILTER=true

# 配額控管（§8）
QUOTA_DAILY_LIMIT=10000
QUOTA_CIRCUIT_BREAKER=8000
VERIFY_PER_ROUND=8
RETURN_PER_ROUND=5
